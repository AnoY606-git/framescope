set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED ENV{FRAMESCOPE_LLVM_MINGW})
  message(FATAL_ERROR "Set FRAMESCOPE_LLVM_MINGW to the extracted LLVM-MinGW toolchain root.")
endif()
file(TO_CMAKE_PATH "$ENV{FRAMESCOPE_LLVM_MINGW}" llvm_root)
set(CMAKE_C_COMPILER "${llvm_root}/bin/x86_64-w64-mingw32-clang.exe")
set(CMAKE_CXX_COMPILER "${llvm_root}/bin/x86_64-w64-mingw32-clang++.exe")
set(CMAKE_RC_COMPILER "${llvm_root}/bin/x86_64-w64-mingw32-windres.exe")
