#include <windows.h>

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @FRAMESCOPE_RESOURCE_TYPE@
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AnoY606-git\0"
            VALUE "FileDescription", "@FRAMESCOPE_RESOURCE_DESCRIPTION@\0"
            VALUE "FileVersion", "@FRAMESCOPE_VERSION@\0"
            VALUE "InternalName", "@FRAMESCOPE_RESOURCE_FILENAME@\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 AnoY606-git\0"
            VALUE "OriginalFilename", "@FRAMESCOPE_RESOURCE_FILENAME@\0"
            VALUE "ProductName", "FrameScope\0"
            VALUE "ProductVersion", "@FRAMESCOPE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
