<UserControl x:Class="FrameScope.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Ваш HUD. Ваш ритм." FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="От компактной строки до подробной панели. Каждый профиль хранит свои настройки независимо." Style="{StaticResource Muted}" Margin="0,7,0,22" />
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Профиль" Style="{StaticResource Muted}" Margin="0,0,0,7" /><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Название профиля" Style="{StaticResource Muted}" Margin="0,0,0,7" /><TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" /></StackPanel>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" DataContext="{Binding SelectedProfile}">
                <StackPanel>
                    <TextBlock Text="Расположение и форма" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Включить нативный HUD (F8)" IsChecked="{Binding Enabled}" Margin="0,0,0,18" />
                    <TextBlock Text="Компоновка" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <ComboBox SelectedIndex="{Binding LayoutIndex}"><ComboBoxItem Content="Панель · вертикально" /><ComboBoxItem Content="Компактная строка · горизонтально" /></ComboBox>
                    <TextBlock Text="Угол экрана" Style="{StaticResource Muted}" Margin="0,18,0,6" />
                    <ComboBox SelectedIndex="{Binding CornerIndex}"><ComboBoxItem Content="Слева сверху" /><ComboBoxItem Content="Справа сверху" /><ComboBoxItem Content="Слева снизу" /><ComboBoxItem Content="Справа снизу" /></ComboBox>
                    <DockPanel Margin="0,20,0,0"><TextBlock Text="Масштаб" /><TextBlock Text="{Binding Scale, StringFormat={}{0:0.00}×}" TextAlignment="Right" Foreground="{StaticResource AccentBrush}" /></DockPanel>
                    <Slider Minimum="0.6" Maximum="2.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Scale}" />
                    <DockPanel Margin="0,12,0,0"><TextBlock Text="Непрозрачность фона" /><TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}" TextAlignment="Right" Foreground="{StaticResource AccentBrush}" /></DockPanel>
                    <Slider Minimum="0.15" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Opacity}" />
                    <DockPanel Margin="0,12,0,0"><TextBlock Text="Отступ по горизонтали" /><TextBlock Text="{Binding MarginX, StringFormat={}{0:0} px}" TextAlignment="Right" Foreground="{StaticResource AccentBrush}" /></DockPanel>
                    <Slider Minimum="0" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MarginX}" />
                    <DockPanel Margin="0,12,0,0"><TextBlock Text="Отступ по вертикали" /><TextBlock Text="{Binding MarginY, StringFormat={}{0:0} px}" TextAlignment="Right" Foreground="{StaticResource AccentBrush}" /></DockPanel>
                    <Slider Minimum="0" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MarginY}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" DataContext="{Binding SelectedProfile}">
                    <StackPanel>
                        <TextBlock Text="Что показывать" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="2">
                            <CheckBox Content="FPS приложения" IsChecked="{Binding ShowFps}" /><CheckBox Content="Present interval" IsChecked="{Binding ShowFrametime}" />
                            <CheckBox Content="CPU / max logical" IsChecked="{Binding ShowCpu}" /><CheckBox Content="GPU engine max" IsChecked="{Binding ShowGpu}" />
                            <CheckBox Content="RAM" IsChecked="{Binding ShowRam}" /><CheckBox Content="Dedicated VRAM" IsChecked="{Binding ShowVram}" />
                            <CheckBox Content="1% / 0.1% lows" IsChecked="{Binding ShowLows}" /><CheckBox Content="График интервалов" IsChecked="{Binding ShowGraph}" />
                        </UniformGrid>
                        <CheckBox Content="Температура CPU / GPU (Sysman / WDDM)" IsChecked="{Binding ShowTemperatures}" />
                        <TextBlock Text="INTEL · РАСШИРЕННЫЕ МЕТРИКИ" Style="{StaticResource Muted}" Margin="0,18,0,5" />
                        <UniformGrid Columns="2">
                            <CheckBox Content="GPU / memory clocks" IsChecked="{Binding ShowIntelClocks}" /><CheckBox Content="GPU / board power" IsChecked="{Binding ShowIntelPower}" />
                            <CheckBox Content="Memory read / write" IsChecked="{Binding ShowIntelBandwidth}" /><CheckBox Content="Throttle flags" IsChecked="{Binding ShowIntelThrottle}" />
                        </UniformGrid>
                        <TextBlock Text="Intel helper: --watch --legacy, точный PCI match. GPU temperature: Sysman gpu_max или честно подписанный WDDM fallback. Memory MHz может означать effective rate. Нет достоверного поля / helper заблокирован — N/A; fan и CPU temperature — N/A." Style="{StaticResource Muted}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" DataContext="{Binding SelectedProfile}">
                    <StackPanel>
                        <TextBlock Text="Цветовая схема" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Текст" Style="{StaticResource Muted}" Margin="0,0,0,6" /><TextBox Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" FontFamily="Consolas" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Акцент" Style="{StaticResource Muted}" Margin="0,0,0,6" /><TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" FontFamily="Consolas" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Фон" Style="{StaticResource Muted}" Margin="0,0,0,6" /><TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" FontFamily="Consolas" /></StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource Muted}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="Сохранить профили" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" /><Button Content="Сбросить этот профиль" Command="{Binding ResetCommand}" Margin="10,0,0,0" /></StackPanel>
                    <TextBlock Text="{Binding DirtyLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextAlignment="Right" Margin="15,0,0,0" />
                </DockPanel>
                <TextBlock Text="{Binding SettingsMessage}" Style="{StaticResource Muted}" Margin="0,16,0,0" />
                <TextBlock Text="{Binding SettingsPath}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                <TextBlock Text="portable.txt рядом с FrameScope.exe — настройки рядом с приложением. Иначе — LocalAppData\FrameScope. Запись атомарная; повреждённый оригинал сохраняется отдельно." Style="{StaticResource Muted}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <Border Background="#2B261B" BorderBrush="#5B4B2D" BorderThickness="1" CornerRadius="8" Padding="16">
            <TextBlock Text="В этом preview нет внешнего оверлея и нет подключения к сторонним играм. Для реального предпросмотра запустите своё демо на странице «Обзор». Настройки передаются в нативный HUD вживую." Foreground="{StaticResource WarningBrush}" />
        </Border>
    </StackPanel>
</UserControl>
